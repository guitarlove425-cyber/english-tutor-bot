# Telegram BotFather token
BOT_TOKEN=your_telegram_bot_token

# Google AI Studio / Gemini API key
GEMINI_API_KEY=your_gemini_api_key

# Use a model returned by `npm run check` if the default is unavailable
GEMINI_MODEL=gemini-flash-latest

# Telegram user ID allowed to run /upgrade
ADMIN_ID=123456789

# Free requests per user per UTC day
DAILY_FREE_LIMIT=5

# Render or other hosting platform port (normally injected automatically)
PORT=3000

# Choose one Firebase credential method for persistent usage/premium data.
# Option A: raw JSON, kept only in the host secret store
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Option B: base64-encoded service-account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_value
# Option C: path to a local ignored JSON file
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-key.json
